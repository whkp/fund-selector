# Runtime mode: REFERENCE (AKShare public reference) or PRODUCTION
# (requires licensed sources and security controls).
FUND_COMPASS_MODE=REFERENCE
FUND_COMPASS_PRODUCTION_DATA_READY=false
FUND_COMPASS_PUBLIC_WRITE_ENABLED=false
FUND_COMPASS_PUBLIC_RESEARCH_ENABLED=true
FUND_COMPASS_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
FUND_COMPASS_DATABASE_URL=sqlite+aiosqlite:///./data/fund-compass.db
FUND_COMPASS_API_ADDR=127.0.0.1:8080

# AKShare calls are server-side and enabled by default.
FUND_COMPASS_AKSHARE_ENABLED=true
FUND_COMPASS_AKSHARE_TIMEOUT_SECONDS=20
FUND_COMPASS_ETF_CODES=510050,510300,588000

# Reference caches expire after this many seconds and are refetched on the next request.
# Fund NAV is disclosed daily, so 6 hours is plenty. Lower it for fresher data at the
# cost of more upstream load; raise it if the upstream rate-limits you.
FUND_COMPASS_FUNDS_TTL_SECONDS=21600
FUND_COMPASS_HISTORY_TTL_SECONDS=21600

# Normal operation uses config/fund-compass.json; environment variables below are optional overrides.
# FUND_COMPASS_CONFIG_FILE=config/fund-compass.json
# Never put secrets in VITE_* variables.
