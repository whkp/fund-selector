# Runtime mode: REFERENCE (AKShare public reference) or PRODUCTION
# (requires licensed sources and security controls).
FUND_COMPASS_MODE=REFERENCE
FUND_COMPASS_API_ADDR=127.0.0.1:8080

# AKShare calls are server-side and enabled by default.
FUND_COMPASS_AKSHARE_ENABLED=true
FUND_COMPASS_AKSHARE_TIMEOUT_SECONDS=20
FUND_COMPASS_ETF_CODES=510050,510300,588000

# Normal operation uses config/fund-compass.json; environment variables below are optional overrides.
# FUND_COMPASS_CONFIG_FILE=config/fund-compass.json
# Never put secrets in VITE_* variables.
