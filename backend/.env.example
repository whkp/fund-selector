# REFERENCE enables AKShare public reference providers.
FUND_COMPASS_MODE=REFERENCE
FUND_COMPASS_API_ADDR=127.0.0.1:8080
FUND_COMPASS_AKSHARE_ENABLED=false
FUND_COMPASS_AKSHARE_TIMEOUT_SECONDS=20
FUND_COMPASS_ETF_CODES=510050,510300,588000
FUND_COMPASS_LLM_PROVIDER=openai-compatible
FUND_COMPASS_LLM_MODEL=gpt-4o-mini
FUND_COMPASS_LLM_BASE_URL=https://api.openai.com/v1
FUND_COMPASS_LLM_API_KEY=replace-with-secret
FUND_COMPASS_LLM_TIMEOUT_SECONDS=45
